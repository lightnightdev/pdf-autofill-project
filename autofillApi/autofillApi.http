### 
# POST https://www.lightnightdev.com/autofill/api/api/Auth/login
# GET https://www.lightnightdev.com/autofill/api/api/Auth/test
# GET https://www.lightnightdev.com/autofill/api/api/autofill/data/${id}
# POST https://www.lightnightdev.com/autofill/api/api/autofill
# DELETE https://www.lightnightdev.com/autofill/api/api/autofill/${id}
# GET https://www.lightnightdev.com/autofill/api/api/list
### Access protected route
GET {{autofillApi_HostAddress}}/Auth/test
Authorization: Bearer {{BearerToken}}


### Get list (no PDF blobs)
GET {{autofillApi_HostAddress}}/autofill/list
Authorization: Bearer {{BearerToken}}

### Get one PDF
GET {{autofillApi_HostAddress}}/autofill/pdf/3
Authorization: Bearer {{BearerToken}}

## Get Data
GET {{autofillApi_HostAddress}}/autofill/data/3
Authorization: Bearer {{BearerToken}}

### Create
POST {{autofillApi_HostAddress}}/autofill
Authorization: Bearer {{BearerToken}}
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="CarrierName"

Test Carrier

--MyBoundary
Content-Disposition: form-data; name="CsvFileName"

data.csv

--MyBoundary
Content-Disposition: form-data; name="CsvMarkerData"

{ "x": 100, "y": 200 }

--MyBoundary
Content-Disposition: form-data; name="PdfFile"; filename="file.pdf"
Content-Type: application/pdf

< ./test.pdf

--MyBoundary--

### Delete
DELETE {{autofillApi_HostAddress}}/api/autofill/5
